{
    "name": "jorisnoo/craft-queue-failure-handler",
    "description": "Release matching queue jobs after they fail, instead of leaving them in the failed-jobs list. Pairs with webhubworks/craft-flare for reporting.",
    "keywords": [
        "craft",
        "cms",
        "craftcms",
        "queue",
        "flare",
        "errors"
    ],
    "homepage": "https://github.com/jorisnoo/craft-queue-failure-handler",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Joris Noordermeer",
            "email": "contact@noordermeer.ch",
            "homepage": "https://github.com/jorisnoo"
        }
    ],
    "support": {
        "source": "https://github.com/jorisnoo/craft-queue-failure-handler",
        "issues": "https://github.com/jorisnoo/craft-queue-failure-handler/issues"
    },
    "require": {
        "php": "^8.2",
        "craftcms/cms": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Noo\\CraftQueueFailureHandler\\": "src/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "yiisoft/yii2-composer": true,
            "craftcms/plugin-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
